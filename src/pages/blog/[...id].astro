---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { getLangFromUrl, useTranslations } from '../../utils/i18n';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft && post.data.lang === 'en');

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: post.data.lang === 'zh' ? 'zh-CN' : 'en-US',
  url: Astro.url.href,
  keywords: post.data.tags,
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};

const tocHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 3 && heading.slug && heading.text,
);
const showToc = tocHeadings.length >= 2;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <article class="post fade-up">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
    <header class="post-header doc-head">
      <p class="eyebrow">Memo · {formatDate(post.data.pubDate, 'long')}</p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="meta-row">
        <span><b>Published:</b> <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'long')}</time></span>
        {post.data.updatedDate && (
          <span><b>Updated:</b> <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, 'long')}</time></span>
        )}
        {post.data.sourcePath && <span><b>Source:</b> <code>{post.data.sourcePath}</code></span>}
      </div>
      {post.data.tags.length > 0 && (
        <div class="tag-list" style="margin-top: 18px;">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    <div class:list={['post-layout', showToc ? 'has-toc' : '']}>
      {showToc && (
        <aside class="post-toc-aside">
          <nav class="toc-nav" aria-label="Table of contents">
            <p class="toc-eyebrow">{t('page.post.contents')}</p>
            <ol class="toc-list">
              {tocHeadings.map((heading) => (
                <li class:list={['toc-item', `is-depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]');
  if (links.length > 0) {
    const targets: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.dataset.tocLink;
      if (!slug) return;
      const target = document.getElementById(slug);
      if (target) targets.push(target);
    });

    const setActive = (slug: string | null) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.tocLink === slug);
      });
    };

    let currentSlug: string | null = targets[0]?.id ?? null;
    setActive(currentSlug);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .map((entry) => entry.target as HTMLElement)
          .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);

        if (visible.length > 0) {
          const next = visible[0].id;
          if (next !== currentSlug) {
            currentSlug = next;
            setActive(currentSlug);
          }
        }
      },
      { rootMargin: '-96px 0px -65% 0px', threshold: [0, 1] },
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>

<style is:global>
  .post-header { margin-bottom: 48px; max-width: 820px; }

  .post-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    margin: 0 0 18px;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    font-weight: 800;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .post-layout.has-toc {
      grid-template-columns: 220px minmax(0, 1fr);
    }
  }

  .post-toc-aside { display: none; }

  @media (min-width: 1024px) {
    .post-toc-aside {
      display: block;
      position: sticky;
      top: 32px;
      align-self: start;
      max-height: calc(100vh - 64px);
      overflow-y: auto;
      font-size: 13px;
    }
  }

  .toc-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
    font-weight: 700;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid var(--line);
  }

  .toc-item a {
    display: block;
    padding: 5px 0 5px 14px;
    color: var(--text-mid);
    font-size: 13px;
    line-height: 1.45;
    text-decoration: none;
    border: none;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc-item.is-depth-3 a {
    padding-left: 26px;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  .toc-item a:hover { color: var(--text-strong); }

  .toc-item a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  /* Prose — markdown rendering */
  .prose {
    max-width: 760px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--text);
  }

  .prose > * + * { margin-top: 1.1em; }

  .prose h2, .prose h3, .prose h4 {
    color: var(--text-strong);
    margin-top: 2.4em;
    margin-bottom: 0.6em;
    scroll-margin-top: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .prose h2 {
    font-size: 1.55rem;
    padding-top: 0.4em;
  }
  .prose h2::before {
    content: "§ ";
    color: var(--accent);
    font-weight: 600;
  }

  .prose h3 {
    font-size: 1.2rem;
    padding-top: 0.5em;
    border-top: 1px solid var(--line);
  }

  .prose h4 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-top: 1.5em;
    margin-bottom: 0.4em;
    font-weight: 700;
  }

  .prose p { margin: 0 0 1em; color: var(--text); }
  .prose strong { color: var(--text-strong); font-weight: 600; }
  .prose em { color: var(--text); }

  .prose ul, .prose ol {
    padding-left: 1.4em;
    margin: 0 0 1.2em;
  }

  .prose li { margin-bottom: 0.4em; color: var(--text); }
  .prose li::marker { color: var(--text-dim); }
  .prose li > strong { color: var(--text-strong); }

  .prose a {
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid rgba(142,206,240,0.3);
  }
  .prose a:hover { color: var(--cyan); border-bottom-color: var(--cyan); }

  .prose blockquote {
    margin: 1.6em 0;
    padding: 14px 18px;
    border-left: 3px solid var(--accent);
    background: rgba(184, 164, 255, 0.05);
    color: var(--text);
    border-radius: 0 6px 6px 0;
    font-style: normal;
  }
  .prose blockquote p { margin: 0; }
  .prose blockquote p + p { margin-top: 0.6em; }
  .prose blockquote strong { color: var(--accent); }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: rgba(158, 240, 226, 0.08);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--cyan);
    border: none;
  }

  .prose pre {
    background: #050508;
    border: 1px solid var(--line);
    padding: 14px 16px;
    border-radius: 7px;
    overflow-x: auto;
    margin: 1.4em 0;
    font-size: 12.5px;
    line-height: 1.6;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
    border: none;
    color: var(--text);
    font-size: 12.5px;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.4em 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-size: 13.5px;
  }

  .prose th, .prose td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    color: var(--text-dim);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .prose td { color: var(--text); }
  .prose td code { font-size: 12.5px; }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    margin: 1.6em 0;
  }
</style>
