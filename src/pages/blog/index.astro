---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { getLangFromUrl, useTranslations } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t('page.blog.eyebrow')} description={t('page.blog.lead')}>
  <section class="fade-up doc-head">
    <p class="eyebrow">{t('page.blog.eyebrow')}</p>
    <h1 class="page-title">{t('page.blog.title')}</h1>
    <p class="lead">{t('page.blog.lead')}</p>
    <div class="meta-row">
      <span><b>Posts:</b> {posts.length}</span>
      {posts[0] && <span><b>Last update:</b> {formatDate(posts[0].data.updatedDate ?? posts[0].data.pubDate, 'long')}</span>}
    </div>
  </section>

  <section class="fade-up" style="margin-top: 56px; animation-delay: 0.08s">
    <ol class="post-list">
      {posts.map((post) => (
        <li class="post-row">
          <a class="post-link" href={`${lang === 'zh' ? '/zh' : ''}/blog/${post.id}/`}>
            <div class="post-row-head">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="post-arrow" aria-hidden="true">→</span>
            </div>
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="tag-list">
                {post.data.tags.slice(0, 5).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </a>
        </li>
      ))}
    </ol>
    {posts.length === 0 && (
      <p class="empty-state">No posts in this language yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-row { border-top: 1px solid var(--line); }
  .post-row:last-child { border-bottom: 1px solid var(--line); }

  .post-link {
    display: block;
    padding: 28px 4px;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
    transition: background 0.2s ease, padding 0.2s ease;
  }

  .post-link:hover {
    background: var(--bg-2);
    padding-left: 18px;
    padding-right: 18px;
    color: inherit;
  }

  .post-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .post-row-head time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-arrow {
    font-family: var(--font-mono);
    color: var(--text-dim);
    font-size: 1rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .post-link:hover .post-arrow { color: var(--accent); transform: translateX(4px); }

  .post-title {
    font-size: 1.45rem;
    color: var(--text-strong);
    line-height: 1.25;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }
  .post-link:hover .post-title { color: var(--accent-strong); }

  .post-desc {
    color: var(--text-mid);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 720px;
  }

  .tag-list { margin-top: 14px; }

  .empty-state { color: var(--text-dim); font-style: italic; }

  @media (max-width: 600px) {
    .post-link { padding: 22px 4px; }
    .post-title { font-size: 1.2rem; }
  }
</style>
