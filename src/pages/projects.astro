---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/site';
---

<BaseLayout title="Projects" description="Selected projects, experiments, and build notes.">
  <section>
    <p class="eyebrow">Projects</p>
    <h1 class="page-title">Work worth explaining.</h1>
    <p class="lead">
      A portfolio index for products, experiments, and research threads. Each card can later link to
      a longer project write-up or repository.
    </p>
  </section>

  <section class="section">
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <p class="eyebrow">{project.status}</p>
            <h2>{project.name}</h2>
            <p>{project.description}</p>
            <div class="tag-list">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
