---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, resume, timeline } from '../data/site';

---

<BaseLayout
  title="Resume"
  description="Tianchi Cai — Founder & CEO. Resume covering LLMs, reinforcement learning, RAG, and large-scale optimization."
>
  <section class="fade-up">
    <p class="eyebrow">Resume</p>
    <h1 class="page-title">{profile.name}.</h1>
    <p class="lead">{resume.summary}</p>
  </section>

  <section class="section fade-up" style="animation-delay: 0.1s">
    <div class="resume-layout">
      <div class="resume-main">
        
        <div class="resume-section">
          <h2 class="section-title">Current</h2>
          <div class="resume-item current">
            <div class="meta">
              <span class="period">{resume.current.period}</span>
            </div>
            <div class="content">
              <h3>{resume.current.role}</h3>
              <div class="company">{resume.current.company}</div>
              <ul>
                {resume.current.details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <div class="resume-section">
          <h2 class="section-title">Experience</h2>
          {
            resume.experience.map((item) => (
              <div class="resume-item">
                <div class="meta">
                  <span class="period">{item.period}</span>
                </div>
                <div class="content">
                  <h3>{item.role}</h3>
                  <div class="company">{item.company}</div>
                  <ul>
                    {item.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>

        <div class="resume-section">
          <h2 class="section-title">Education</h2>
          {
            resume.education.map((item) => (
              <div class="resume-item">
                <div class="meta">
                  <span class="period">{item.period}</span>
                </div>
                <div class="content">
                  <h3>{item.school}</h3>
                  <div class="company">{item.degree}</div>
                  <ul>
                    {item.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>

      </div>

      <aside class="resume-sidebar">
        <div class="sidebar-block">
          <h3>Skills</h3>
          <div class="tag-list">
            {resume.skills.map((skill) => <span class="tag">{skill}</span>)}
          </div>
        </div>

        <div class="sidebar-block">
          <h3>Selected Papers</h3>
          <ul class="paper-list">
            {
              resume.publications.map((p) => (
                <li>
                  <div class="paper-title">{p.title}</div>
                  <div class="paper-venue">{p.venue}</div>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 64px;
    align-items: start;
  }

  .resume-section {
    margin-bottom: 64px;
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
    color: var(--text-strong);
  }

  .resume-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    margin-bottom: 40px;
  }

  .resume-item.current {
    position: relative;
  }

  .resume-item.current::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 6px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .meta .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .content h3 {
    font-size: 1.2rem;
    margin-bottom: 4px;
  }

  .content .company {
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .content ul {
    margin: 0;
    padding-left: 16px;
    color: var(--text);
  }

  .content li {
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .content li::marker {
    color: var(--line-strong);
  }

  .resume-sidebar {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .sidebar-block h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 24px;
    font-family: var(--font-mono);
  }

  .paper-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .paper-title {
    color: var(--text-strong);
    font-size: 0.95rem;
    line-height: 1.4;
    margin-bottom: 6px;
    font-weight: 500;
  }

  .paper-venue {
    color: var(--secondary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  @media (max-width: 960px) {
    .resume-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    
    .resume-sidebar {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .resume-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    
    .resume-item.current::before {
      display: none;
    }
  }
</style>
