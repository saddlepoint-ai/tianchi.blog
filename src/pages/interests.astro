---
import BaseLayout from '../layouts/BaseLayout.astro';
import { interests } from '../data/site';
---

<BaseLayout title="Interests" description="Rowing notes and personal interests.">
  <section>
    <p class="eyebrow">Interests</p>
    <h1 class="page-title">Rowing, for now.</h1>
    <p class="lead">
      Keeping this page intentionally small for now. Rowing is the one personal thread worth putting
      here before the rest of the site fills in.
    </p>
  </section>

  <section class="section">
    <div class="grid two">
      {
        interests.map((interest, index) => (
          <article class="card">
            <p class="eyebrow">Interest {String(index + 1).padStart(2, '0')}</p>
            <h2>{interest}</h2>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
