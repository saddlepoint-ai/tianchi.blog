---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { interests, profile, site } from '../data/site';
import { formatDate } from '../utils/date';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero">
    <div>
      <p class="eyebrow">Personal field notebook</p>
      <h1>Tianchi keeps notes.</h1>
      <p class="lead">{profile.intro}</p>
      <div class="tag-list" aria-label="Current focus areas">
        {profile.focusAreas.map((area) => <span class="tag">{area}</span>)}
      </div>
    </div>
    <aside class="panel">
      <p class="eyebrow is-secondary">Resume snapshot</p>
      <h2>{profile.headline}</h2>
      <p>{profile.location}</p>
      <a href="/resume/">Read the resume →</a>
    </aside>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <span class="section-badge is-secondary" aria-hidden="true">A</span>
        <div>
          <p class="eyebrow is-secondary">Notebook</p>
          <h2>Latest writing</h2>
        </div>
      </div>
      <a href="/blog/">All posts →</a>
    </div>
    <div class="article-list">
      {
        posts.map((post) => (
          <a class="article-link" href={`/blog/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <span class="section-badge is-mint" aria-hidden="true">B</span>
        <div>
          <p class="eyebrow is-mint">Interests</p>
          <h2>Rowing notes</h2>
        </div>
      </div>
    </div>
    <div class="grid two">
      {interests.map((item) => <article class="card"><h3>{item}</h3></article>)}
    </div>
  </section>
</BaseLayout>
