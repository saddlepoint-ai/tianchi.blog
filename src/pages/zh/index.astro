---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { data } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const { profile, resume } = data[lang];
const t = useTranslations(lang);
---

<BaseLayout
  title={t('page.resume.eyebrow')}
  description={`${profile.name} — ${profile.headline}`}
>
  <section class="fade-up doc-head">
    <p class="eyebrow">{t('page.resume.eyebrow')}</p>
    <h1 class="page-title">{profile.name}.</h1>
    <p class="lead">{resume.summary}</p>
    <div class="meta-row">
      <span><b>角色：</b>{profile.role}</span>
      <span><b>方向：</b>{profile.headline}</span>
      <span><b>常驻：</b>{profile.location}</span>
    </div>
  </section>

  <section class="fade-up resume-grid" style="animation-delay: 0.08s">
    <div class="resume-main">

      <div class="resume-section">
        <h2 class="section-title"><span class="section-mark">§</span>{t('page.resume.current')}</h2>
        <div class="resume-item current">
          <div class="meta">
            <span class="period">{resume.current.period}</span>
            <span class="chip cyan">active</span>
          </div>
          <div class="content">
            <h3>{resume.current.role}</h3>
            <div class="company">{resume.current.company}</div>
            <ul>
              {resume.current.details.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <div class="resume-section">
        <h2 class="section-title"><span class="section-mark">§</span>{t('page.resume.experience')}</h2>
        {resume.experience.map((item) => (
          <div class="resume-item">
            <div class="meta"><span class="period">{item.period}</span></div>
            <div class="content">
              <h3>{item.role}</h3>
              <div class="company">{item.company}</div>
              <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>

      <div class="resume-section">
        <h2 class="section-title"><span class="section-mark">§</span>{t('page.resume.education')}</h2>
        {resume.education.map((item) => (
          <div class="resume-item">
            <div class="meta"><span class="period">{item.period}</span></div>
            <div class="content">
              <h3>{item.school}</h3>
              <div class="company">{item.degree}</div>
              <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>

    </div>

    <aside class="resume-sidebar">
      <div class="sidebar-block">
        <h4 class="sidebar-title">{t('page.resume.skills')}</h4>
        <div class="tag-list">
          {resume.skills.map((skill) => <span class="tag">{skill}</span>)}
        </div>
      </div>

      <div class="sidebar-block">
        <h4 class="sidebar-title">{t('page.resume.papers')}</h4>
        <ul class="paper-list">
          {resume.publications.map((p) => (
            <li>
              <div class="paper-title">{p.title}</div>
              <div class="paper-meta">
                <span class="paper-venue">{p.venue}</span>
                {p.tag && <span class="chip purple">{p.tag}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .resume-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 56px; align-items: start; }
  .resume-section { margin-bottom: 56px; }
  .resume-section:last-child { margin-bottom: 0; }
  .section-title { font-size: 1.2rem; margin-bottom: 28px; padding-bottom: 10px; border-bottom: 1px solid var(--line); color: var(--text-strong); font-weight: 700; letter-spacing: -0.02em; display: flex; align-items: baseline; gap: 8px; }
  .section-mark { color: var(--accent); font-family: var(--font-mono); font-weight: 600; }
  .resume-item { display: grid; grid-template-columns: 130px 1fr; gap: 24px; margin-bottom: 32px; }
  .resume-item:last-child { margin-bottom: 0; }
  .meta { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .meta .period { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-dim); letter-spacing: 0.02em; }
  .content h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 4px; color: var(--text-strong); letter-spacing: -0.015em; }
  .content .company { color: var(--accent); font-size: 0.85rem; font-weight: 500; margin-bottom: 12px; font-family: var(--font-mono); }
  .content ul { margin: 0; padding-left: 18px; color: var(--text); }
  .content li { margin-bottom: 6px; line-height: 1.6; font-size: 0.94rem; }
  .content li::marker { color: var(--text-dim); }
  .resume-sidebar { position: sticky; top: 32px; display: flex; flex-direction: column; gap: 36px; }
  .sidebar-block { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px; }
  .sidebar-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin-bottom: 16px; font-family: var(--font-mono); font-weight: 700; }
  .sidebar-block .tag-list { margin-top: 0; gap: 6px; }
  .paper-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .paper-list li { padding-bottom: 16px; border-bottom: 1px dashed var(--line); }
  .paper-list li:last-child { padding-bottom: 0; border-bottom: none; }
  .paper-title { color: var(--text); font-size: 0.86rem; line-height: 1.45; margin-bottom: 6px; font-weight: 500; }
  .paper-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .paper-venue { color: var(--text-dim); font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.02em; }
  :global(.chip) { display: inline-block; font-size: 10px; padding: 1px 7px; border-radius: 4px; font-family: var(--font-mono); font-weight: 600; letter-spacing: 0.04em; text-transform: lowercase; }
  :global(.chip.purple) { background: rgba(184,164,255,0.12); color: var(--accent); }
  :global(.chip.cyan) { background: rgba(158,240,226,0.12); color: var(--cyan); }
  @media (max-width: 960px) { .resume-grid { grid-template-columns: 1fr; gap: 48px; } .resume-sidebar { position: static; } }
  @media (max-width: 600px) { .resume-item { grid-template-columns: 1fr; gap: 6px; } .meta { flex-direction: row; align-items: center; gap: 10px; } }
</style>
