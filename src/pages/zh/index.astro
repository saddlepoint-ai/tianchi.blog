---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { data } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const { profile, timeline, site } = data[lang];
const t = useTranslations(lang);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero fade-up">
    <p class="eyebrow">{t('page.home.eyebrow')}</p>
    <h1 class="page-title">{profile.name}.</h1>
    <p class="lead">
      {t('page.home.lead')} <code>agent-harnesses</code>, <code>RL</code>, {lang === 'en' ? 'and' : '与'} <code>context-engineering</code>.
    </p>
    <div class="tag-list">
      {profile.focusAreas.map((area) => <span class="tag">{area}</span>)}
    </div>
  </section>

  <section class="section fade-up" style="animation-delay: 0.1s">
    <div class="section-heading">
      <h2>{t('page.home.experience')}</h2>
    </div>
    <div class="track-record">
      {
        timeline.map((step) => (
          <div class="track-item">
            <div class="track-period">{step.period}</div>
            <div class="track-content">
              <h3>{step.label}</h3>
              <p>{step.sub}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 40px;
  }

  .track-record {
    display: flex;
    flex-direction: column;
  }

  .track-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    transition: all 0.3s ease;
  }

  .track-item:last-child {
    border-bottom: none;
  }

  .track-item:hover .track-period {
    color: var(--accent);
  }

  .track-period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .track-content h3 {
    font-size: 1.25rem;
    margin-bottom: 8px;
    color: var(--text-strong);
  }

  .track-content p {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
  }

  @media (max-width: 600px) {
    .track-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 24px 0;
    }
  }
</style>
