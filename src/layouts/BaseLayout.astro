---
import { data } from '../data/site';
import { getLangFromUrl, useTranslations } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const lang = getLangFromUrl(Astro.url);
const siteData = data[lang].site;
const navItems = data[lang].navItems;
const t = useTranslations(lang);

const {
  title = siteData.title,
  description = siteData.description,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title === siteData.title ? title : `${title} | ${siteData.title}`;
const currentPath = Astro.url.pathname;
const socialImage = new URL('/social-card.svg', Astro.site ?? Astro.url).toString();

const togglePath = lang === 'en' 
  ? `/zh${currentPath === '/' ? '' : currentPath}` 
  : currentPath.replace(/^\/zh/, '') || '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={siteData.author} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={lang === 'en' ? '/' : '/zh/'} aria-label={`${siteData.title} home`}>
          <span class="brand-text">
            <strong>{siteData.title}</strong>
          </span>
        </a>
        <nav aria-label="Primary navigation" class="primary-nav">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'nav-link',
                  currentPath === item.href ||
                  (item.href !== '/' && item.href !== '/zh/' && currentPath.startsWith(item.href))
                    ? 'is-active'
                    : '',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a href={togglePath} class="nav-link lang-toggle" aria-label="Toggle language">
            {lang === 'en' ? '中' : 'EN'}
          </a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <p class="copyright">© {new Date().getFullYear()} {siteData.author}. {t('footer.copyright')}</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    /* Surfaces */
    --bg: #FFFFFF;
    --bg-soft: #FAFAFA;
    --panel: #FFFFFF;
    --panel-tinted: #F4F4F5;
    --panel-strong: #E4E4E7;
    /* Ink */
    --text: #3F3F46;
    --text-strong: #09090B;
    --muted: #71717A;
    --muted-soft: #A1A1AA;
    /* Lines */
    --line: #E4E4E7;
    --line-strong: #D4D4D8;
    /* Accents - Minimalist monochrome */
    --accent: #09090B;
    --accent-strong: #000000;
    --accent-soft: #F4F4F5;
    --secondary: #52525B;
    --secondary-strong: #3F3F46;
    --secondary-soft: #F4F4F5;
    /* Layout */
    --max-width: 900px;
    --radius-lg: 16px;
    --radius-md: 12px;
    --radius-sm: 6px;
    --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.05), 0 4px 12px rgba(0, 0, 0, 0.02);
    /* Type */
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-family: var(--font-sans);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100%;
    margin: 0;
    color: var(--text);
    background: var(--bg);
    font-feature-settings: 'cv11', 'ss01';
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--accent-strong);
    color: var(--bg);
  }

  a {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  a:hover {
    color: var(--accent-strong);
    text-decoration-color: var(--accent-strong);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 8px 14px;
    background: var(--accent-strong);
    color: var(--bg);
    font-weight: 700;
  }
  .skip-link:focus {
    left: 0;
  }

  .site-shell {
    width: min(100% - 48px, var(--max-width));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 0;
    margin-bottom: 32px;
  }

  .brand {
    text-decoration: none;
    color: var(--text-strong);
    display: flex;
    align-items: center;
  }

  .brand-text strong {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .primary-nav {
    display: flex;
    gap: 8px;
  }

  .nav-link {
    padding: 6px 12px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
  }

  .nav-link:hover {
    color: var(--text-strong);
    background: var(--panel-tinted);
  }

  .nav-link.is-active {
    color: var(--text-strong);
    background: var(--panel-tinted);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  
  .lang-toggle {
    font-family: var(--font-mono);
    border-left: 1px solid var(--line);
    border-radius: 0;
    margin-left: 4px;
    padding-left: 16px;
  }

  /* Core UI Primitives */
  .eyebrow {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  h1, h2, h3, h4 {
    color: var(--text-strong);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
  }

  .page-title {
    font-size: clamp(3rem, 8vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 24px;
    color: var(--text-strong);
  }

  .lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--text);
    line-height: 1.6;
    max-width: 640px;
    margin-bottom: 32px;
  }

  .lead code {
    background: var(--panel-tinted);
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-strong);
  }

  .section {
    margin-top: 120px;
  }

  .section-heading {
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
  }

  .section-heading h2 {
    font-size: 1.8rem;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 32px;
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text);
    background: var(--panel-tinted);
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 99px;
  }

  /* Animations */
  .fade-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes fade-in-up {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Footer */
  .site-footer {
    margin-top: 120px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }

  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    
    .primary-nav {
      margin-left: -12px;
    }

    .section {
      margin-top: 80px;
    }
  }
</style>
