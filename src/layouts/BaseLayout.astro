---
import { navItems, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title = site.title,
  description = site.description,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
const currentPath = Astro.url.pathname;
const socialImage = new URL('/social-card.svg', Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={site.author} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${site.title} home`}>
          <span class="brand-text">
            <strong>{site.title}</strong>
          </span>
        </a>
        <nav aria-label="Primary navigation" class="primary-nav">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'nav-link',
                  currentPath === item.href ||
                  (item.href !== '/' && currentPath.startsWith(item.href))
                    ? 'is-active'
                    : '',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <p class="copyright">© {new Date().getFullYear()} {site.author}. All systems nominal.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    /* Surfaces */
    --bg: #000000;
    --bg-soft: #0a0a0a;
    --panel: rgba(255, 255, 255, 0.03);
    --panel-tinted: rgba(255, 255, 255, 0.06);
    --panel-strong: rgba(255, 255, 255, 0.1);
    /* Ink */
    --text: #a1a1aa;
    --text-strong: #ffffff;
    --muted: #71717a;
    --muted-soft: #52525b;
    /* Lines */
    --line: rgba(255, 255, 255, 0.1);
    --line-strong: rgba(255, 255, 255, 0.2);
    /* Accents - Neon Green and Electric Purple */
    --accent: #4ade80;
    --accent-strong: #22c55e;
    --accent-soft: rgba(74, 222, 128, 0.1);
    --secondary: #a855f7;
    --secondary-strong: #9333ea;
    --secondary-soft: rgba(168, 85, 247, 0.1);
    /* Layout */
    --max-width: 1000px;
    --radius-lg: 24px;
    --radius-md: 16px;
    --radius-sm: 8px;
    --shadow-card: 0 4px 24px -4px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.05);
    /* Type */
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-family: var(--font-sans);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100%;
    margin: 0;
    color: var(--text);
    background: radial-gradient(circle at 15% 50%, rgba(168, 85, 247, 0.06), transparent 30vw),
                radial-gradient(circle at 85% 30%, rgba(74, 222, 128, 0.06), transparent 30vw),
                var(--bg);
    font-feature-settings: 'cv11', 'ss01';
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--accent);
  }

  a {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 8px 14px;
    background: var(--accent);
    color: #000;
    font-weight: 700;
  }
  .skip-link:focus {
    left: 0;
  }

  .site-shell {
    width: min(100% - 48px, var(--max-width));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 0;
    margin-bottom: 32px;
  }

  .brand {
    text-decoration: none;
    color: var(--text-strong);
    display: flex;
    align-items: center;
  }

  .brand-text strong {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(to right, #fff, #a1a1aa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .primary-nav {
    display: flex;
    gap: 8px;
  }

  .nav-link {
    padding: 6px 12px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
  }

  .nav-link:hover {
    color: var(--text-strong);
    background: var(--panel);
  }

  .nav-link.is-active {
    color: var(--text-strong);
    background: var(--panel-tinted);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
  }

  /* Core UI Primitives */
  .eyebrow {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  h1, h2, h3, h4 {
    color: var(--text-strong);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
  }

  .page-title {
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 24px;
    background: linear-gradient(135deg, #fff 0%, #71717a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text);
    line-height: 1.6;
    max-width: 640px;
    margin-bottom: 32px;
  }

  .lead code {
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-strong);
  }

  .section {
    margin-top: 120px;
  }

  .section-heading {
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
  }

  .section-heading h2 {
    font-size: 2rem;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 32px;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; right: 0; left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--secondary);
    background: var(--secondary-soft);
    border: 1px solid rgba(168, 85, 247, 0.2);
    padding: 4px 10px;
    border-radius: 99px;
  }

  /* Animations */
  .fade-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes fade-in-up {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Footer */
  .site-footer {
    margin-top: 120px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }

  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    
    .primary-nav {
      margin-left: -12px;
    }

    .section {
      margin-top: 80px;
    }
  }
</style>
