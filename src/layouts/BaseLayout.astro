---
import { navItems, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title = site.title,
  description = site.description,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
const currentPath = Astro.url.pathname;
const socialImage = new URL('/social-card.svg', Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAF6EF" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={site.author} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${site.title} home`}>
          <span class="brand-mark" aria-hidden="true">天</span>
          <span class="brand-text">
            <strong>{site.author}</strong>
            <small>{site.domain}</small>
          </span>
        </a>
        <nav aria-label="Primary navigation" class="primary-nav">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'nav-link',
                  currentPath === item.href ||
                  (item.href !== '/' && currentPath.startsWith(item.href))
                    ? 'is-active'
                    : '',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <p>© {new Date().getFullYear()} {site.author}. Built from Markdown, shipped as static HTML.</p>
          <a class="footer-link" href="/blog/">Read the notebook →</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    /* Surfaces */
    --bg: #faf6ef;
    --bg-soft: #ffffff;
    --panel: #ffffff;
    --panel-tinted: #f6efe2;
    --panel-strong: #f1e7d4;
    /* Ink */
    --text: #1c1f24;
    --text-strong: #0f1218;
    --muted: #6b6358;
    --muted-soft: #8c8478;
    /* Lines */
    --line: rgba(28, 31, 36, 0.12);
    --line-strong: rgba(28, 31, 36, 0.22);
    --line-warm: rgba(199, 106, 63, 0.22);
    /* Accents — copper primary, lavender secondary, restrained mint / rose */
    --accent: #c76a3f;
    --accent-strong: #a44f29;
    --accent-soft: #f5e3d2;
    --secondary: #6e54a8;
    --secondary-strong: #533f86;
    --secondary-soft: #ece5f6;
    --mint: #4f8f6b;
    --mint-soft: #dceadf;
    --rose: #b85571;
    --rose-soft: #f2dde2;
    /* Layout */
    --max-width: 1200px;
    --radius-lg: 28px;
    --radius-md: 20px;
    --radius-sm: 14px;
    --shadow-card: 0 1px 2px rgba(28, 31, 36, 0.04), 0 8px 24px rgba(28, 31, 36, 0.05);
    --shadow-panel: 0 1px 2px rgba(28, 31, 36, 0.04), 0 18px 50px rgba(28, 31, 36, 0.07);
    /* Type */
    --font-sans:
      'Inter', 'Pretendard', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue',
      'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif;
    --font-serif: Charter, 'Bitstream Charter', 'Sitka Text', Cambria, Georgia, serif;
    font-family: var(--font-sans);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100%;
    margin: 0;
    color: var(--text);
    background:
      radial-gradient(circle at 8% -4%, rgba(199, 106, 63, 0.12), transparent 38rem),
      radial-gradient(circle at 92% 6%, rgba(110, 84, 168, 0.1), transparent 32rem),
      var(--bg);
    font-family: var(--font-sans);
    font-feature-settings: 'ss01', 'cv11';
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: '';
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.4'/%3E%3C/svg%3E");
    opacity: 0.04;
    mix-blend-mode: multiply;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  a {
    color: var(--accent-strong);
    text-decoration-color: var(--line-warm);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 8px 14px;
    background: var(--text-strong);
    color: var(--bg);
    border-radius: 0 0 12px 0;
  }
  .skip-link:focus {
    left: 0;
  }

  .site-shell {
    width: min(100% - 32px, var(--max-width));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: max-content;
    text-decoration: none;
    color: var(--text-strong);
  }
  .brand:hover {
    color: var(--text-strong);
    text-decoration-color: transparent;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(140deg, var(--accent) 0%, var(--accent-strong) 100%);
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 800;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5) inset, 0 4px 14px rgba(199, 106, 63, 0.3);
  }

  .brand-text strong {
    display: block;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: -0.005em;
  }

  .brand-text small {
    display: block;
    margin-top: -1px;
    color: var(--muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .primary-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  .nav-link {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 7px 14px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text-strong);
    background: var(--panel-tinted);
    text-decoration-color: transparent;
  }

  .nav-link.is-active {
    border-color: var(--line);
    color: var(--text-strong);
    background: var(--panel);
    box-shadow: 0 1px 2px rgba(28, 31, 36, 0.04);
  }

  main {
    padding: 48px 0 96px;
  }

  /* Editorial primitives */

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent-strong);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow.is-secondary {
    color: var(--secondary-strong);
  }
  .eyebrow.is-mint {
    color: var(--mint);
  }
  .eyebrow.is-muted {
    color: var(--muted);
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--text-strong);
    font-family: var(--font-sans);
    letter-spacing: -0.018em;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.85fr);
    gap: 36px;
    align-items: stretch;
    padding-top: 12px;
  }

  .hero h1,
  .page-title {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .hero h1 {
    max-width: 14ch;
  }

  .page-title {
    max-width: 16ch;
  }

  .lead {
    max-width: 680px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
  }

  .lead code {
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 0.08em 0.38em;
    background: var(--panel-tinted);
    color: var(--accent-strong);
    font-size: 0.9em;
  }

  .panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.6vw, 34px);
    background: linear-gradient(160deg, var(--panel) 0%, var(--panel-tinted) 100%);
    box-shadow: var(--shadow-panel);
  }

  .panel::after {
    position: absolute;
    right: -70px;
    bottom: -90px;
    width: 200px;
    height: 200px;
    border: 1px solid var(--line-warm);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .panel h2 {
    margin: 0 0 8px;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .panel ul {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .panel li {
    position: relative;
    padding-left: 18px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .panel li::before {
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--accent);
    content: '';
  }

  .section {
    margin-top: 80px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 700;
  }

  .section-heading > div {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .section-heading p {
    max-width: 460px;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .section-badge {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    color: var(--accent-strong);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .section-badge.is-secondary {
    color: var(--secondary-strong);
  }
  .section-badge.is-mint {
    color: var(--mint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 24px;
    background: var(--panel);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .card:hover {
    transform: translateY(-1px);
    border-color: var(--line-strong);
    box-shadow: 0 1px 2px rgba(28, 31, 36, 0.05), 0 14px 32px rgba(28, 31, 36, 0.08);
  }

  .card h2,
  .card h3 {
    margin: 0 0 8px;
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .card ul {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .card li + li {
    margin-top: 6px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .tag {
    border: 1px solid var(--line-warm);
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--accent-strong);
    background: var(--accent-soft);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
  }

  a.tag:hover {
    color: var(--accent-strong);
    background: var(--accent-soft);
    text-decoration-color: transparent;
    filter: brightness(0.96);
  }

  .article-list {
    display: grid;
    gap: 14px;
  }

  .article-link {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 22px 24px;
    text-decoration: none;
    color: var(--text);
    background: var(--panel);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .article-link:hover {
    transform: translateY(-1px);
    border-color: var(--line-strong);
    box-shadow: 0 1px 2px rgba(28, 31, 36, 0.05), 0 14px 32px rgba(28, 31, 36, 0.08);
    color: var(--text);
    text-decoration-color: transparent;
  }

  .article-link time {
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-link h2,
  .article-link h3 {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .article-link p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .article-link .tag-list {
    margin-top: 12px;
  }

  /* Long-form prose (Markdown body) */

  .prose {
    max-width: 720px;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.78;
  }

  .prose > * + * {
    margin-top: 1.05em;
  }

  .prose h2 {
    margin: 2.2em 0 0.6em;
    padding-top: 0.6em;
    border-top: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.25;
    scroll-margin-top: 96px;
  }

  .prose h3 {
    margin: 1.7em 0 0.4em;
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    scroll-margin-top: 96px;
  }

  .prose h4 {
    margin: 1.4em 0 0.3em;
    font-family: var(--font-sans);
    font-size: 1.04rem;
    font-weight: 700;
    scroll-margin-top: 96px;
  }

  .prose p,
  .prose li {
    color: var(--text);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li::marker {
    color: var(--accent);
  }

  .prose blockquote {
    margin: 1.4em 0;
    padding: 12px 20px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 12px 12px 0;
    color: var(--text-strong);
    font-style: italic;
  }

  .prose code {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.08em 0.4em;
    background: var(--panel-tinted);
    color: var(--accent-strong);
    font-size: 0.92em;
  }

  .prose pre {
    overflow-x: auto;
    margin: 1.4em 0;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: #1c1f24;
    color: #f3ede1;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .prose pre code {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }

  .prose hr {
    border: 0;
    margin: 2em auto;
    width: 60%;
    border-top: 1px solid var(--line);
  }

  .prose a {
    color: var(--accent-strong);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
  }

  /* Blog post layout (with TOC) */

  .post {
    display: grid;
    gap: 32px;
  }

  .post-header {
    max-width: 760px;
  }

  .post-title {
    margin: 6px 0 14px;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .post-layout.has-toc {
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }

  .post-toc-aside {
    display: none;
  }

  @media (min-width: 960px) {
    .post-toc-aside {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      padding-right: 8px;
    }
  }

  .toc-nav {
    border-left: 1px solid var(--line);
    padding: 4px 0 4px 18px;
  }

  .toc-eyebrow {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .toc-item a {
    display: block;
    padding: 5px 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-item.is-depth-3 a {
    padding-left: 14px;
    font-size: 0.84rem;
  }

  .toc-item a:hover {
    color: var(--text-strong);
  }

  .toc-item a.is-active {
    color: var(--accent-strong);
    font-weight: 600;
  }

  .toc-mobile {
    display: block;
    margin: 0 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--panel);
    box-shadow: var(--shadow-card);
    font-family: var(--font-sans);
  }

  @media (min-width: 960px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile summary {
    cursor: pointer;
    list-style: none;
    padding: 12px 16px;
    color: var(--text-strong);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    list-style: none;
  }

  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile summary::after {
    float: right;
    color: var(--muted);
    content: '+';
    font-size: 1.1rem;
    line-height: 1;
  }

  .toc-mobile[open] summary::after {
    content: '–';
  }

  .toc-mobile .toc-list {
    padding: 0 16px 14px;
  }

  /* Footer */

  .site-footer {
    margin-top: 32px;
    border-top: 1px solid var(--line);
  }

  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 28px 0 40px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-link {
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  /* Responsive */

  @media (max-width: 780px) {
    .site-header,
    .site-footer-inner,
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .primary-nav {
      justify-content: flex-start;
    }

    .hero,
    .grid,
    .grid.two,
    .article-link {
      grid-template-columns: 1fr;
    }

    .article-link {
      gap: 8px;
