---
import { data, siteConfig } from '../data/site';
import { getLangFromUrl, useTranslations } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const lang = getLangFromUrl(Astro.url);
const siteData = data[lang].site;
const navItems = data[lang].navItems;
const t = useTranslations(lang);

const {
  title = siteData.title,
  description = siteData.description,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title === siteData.title ? title : `${title} | ${siteData.title}`;
const currentPath = Astro.url.pathname;
const socialImage = new URL('/social-card.svg', Astro.site ?? Astro.url).toString();

const togglePath = lang === 'en'
  ? `/zh${currentPath === '/' ? '' : currentPath}`
  : currentPath.replace(/^\/zh/, '') || '/';

// hreflang pair URLs (absolute, with trailing slash).
const enPath = lang === 'en' ? currentPath : (currentPath.replace(/^\/zh/, '') || '/');
const zhPath = lang === 'zh' ? currentPath : (currentPath === '/' ? '/zh/' : `/zh${currentPath}`);
const enUrl = new URL(enPath, Astro.site ?? Astro.url).toString();
const zhUrl = new URL(zhPath, Astro.site ?? Astro.url).toString();

// JSON-LD: emit Person on the resume root pages; nothing on blog/posts (post pages
// emit their own BlogPosting JSON-LD).
const isResumeRoot = currentPath === '/' || currentPath === '/zh/';
const personJsonLd = isResumeRoot ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.en.profile.name,
  alternateName: data.zh.profile.name,
  jobTitle: data.en.profile.role,
  description: data.en.resume.summary,
  worksFor: {
    '@type': 'Organization',
    name: data.en.resume.current.company,
  },
  url: new URL('/', Astro.site ?? Astro.url).toString(),
  sameAs: [
    siteConfig.social.googleScholar,
    siteConfig.social.linkedin,
  ].filter(Boolean),
  knowsAbout: data.en.resume.skills,
} : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0c12" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={siteData.author} />}
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="en-US" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    {personJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={lang === 'en' ? '/' : '/zh/'} aria-label={`${siteData.title} home`}>
          <span class="brand-mark">§</span>
          <span class="brand-text">{siteData.title}</span>
        </a>
        <nav aria-label="Primary navigation" class="primary-nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'nav-link',
                currentPath === item.href ||
                (item.href !== '/' && item.href !== '/zh/' && currentPath.startsWith(item.href))
                  ? 'is-active'
                  : '',
              ]}
            >
              {item.label}
            </a>
          ))}
          <a href={togglePath} class="nav-link lang-toggle" aria-label="Toggle language">
            {lang === 'en' ? '中' : 'EN'}
          </a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <p class="copyright">© {new Date().getFullYear()} {siteData.author} · {t('footer.copyright')}</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0c0c12;
    --bg-2: #101017;
    --panel: #131320;
    --panel-tinted: #1a1a26;
    --panel-strong: #1f1f2e;
    --text: #e8e8ef;
    --text-strong: #f4f4f8;
    --text-mid: #a0a0b0;
    --muted: #a0a0b0;
    --text-dim: #6c6c7a;
    --muted-soft: #6c6c7a;
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.14);
    --accent: #b8a4ff;
    --accent-strong: #c8b6ff;
    --accent-soft: rgba(184, 164, 255, 0.08);
    --cyan: #9ef0e2;
    --yellow: #ffd166;
    --red: #ff6b6b;
    --green: #7ce6a3;
    --orange: #ffa76b;
    --blue: #8ecef0;
    --max-width: 1100px;
    --radius-lg: 10px;
    --radius-md: 8px;
    --radius-sm: 5px;
    --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.3), 0 4px 16px rgba(0, 0, 0, 0.15);
    --font-sans: -apple-system, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    --font-mono: 'SF Mono', 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-family: var(--font-sans);
  }
  * { box-sizing: border-box; }
  html { min-height: 100%; background: var(--bg); scroll-behavior: smooth; }
  body { min-height: 100%; margin: 0; color: var(--text); background: var(--bg); font-size: 15px; line-height: 1.72; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  ::selection { background: var(--accent); color: var(--bg); }
  a { color: var(--blue); text-decoration: none; border-bottom: 1px solid rgba(142, 206, 240, 0.3); transition: color 0.15s ease, border-color 0.15s ease; }
  a:hover { color: var(--cyan); border-bottom-color: var(--cyan); }
  .skip-link { position: absolute; left: -9999px; top: 0; z-index: 100; padding: 8px 14px; background: var(--accent); color: var(--bg); font-weight: 700; border-radius: 4px; }
  .skip-link:focus { left: 8px; top: 8px; }
  .site-shell { width: min(100% - 40px, var(--max-width)); margin: 0 auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; padding: 28px 0 24px; margin-bottom: 24px; border-bottom: 1px solid var(--line); }
  .brand { text-decoration: none; color: var(--text-strong); display: flex; align-items: baseline; gap: 8px; border: none; }
  .brand:hover { color: var(--text-strong); }
  .brand-mark { color: var(--accent); font-family: var(--font-mono); font-size: 1.25rem; font-weight: 600; }
  .brand-text { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em; }
  .primary-nav { display: flex; align-items: center; gap: 4px; }
  .nav-link { padding: 6px 12px; color: var(--text-mid); font-size: 0.85rem; font-weight: 500; text-decoration: none; border-radius: var(--radius-sm); border: 1px solid transparent; transition: all 0.15s ease; }
  .nav-link:hover { color: var(--text-strong); background: var(--panel-tinted); border-color: transparent; }
  .nav-link.is-active { color: var(--accent); background: var(--accent-soft); border-color: rgba(184, 164, 255, 0.2); }
  .lang-toggle { font-family: var(--font-mono); font-size: 0.78rem; margin-left: 8px; padding-left: 14px; border-left: 1px solid var(--line); border-radius: 0; }
  .eyebrow { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 12px; }
  h1, h2, h3, h4 { color: var(--text-strong); line-height: 1.2; margin: 0; letter-spacing: -0.02em; }
  h1 { font-weight: 800; } h2 { font-weight: 700; } h3 { font-weight: 700; } h4 { font-weight: 700; }
  .page-title { font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08; margin-bottom: 18px; color: var(--text-strong); }
  .lead { font-size: clamp(1.0rem, 1.6vw, 1.15rem); color: var(--text-mid); line-height: 1.65; max-width: 640px; margin-bottom: 28px; }
  .lead code { background: var(--panel-tinted); border: 1px solid var(--line); padding: 1px 6px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.88em; color: var(--cyan); }
  .section { margin-top: 80px; }
  .section-heading { margin-bottom: 32px; border-bottom: 1px solid var(--line); padding-bottom: 16px; }
  .section-heading h2 { font-size: 1.55rem; }
  .doc-head { margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .meta-row { font-size: 13px; color: var(--text-dim); display: flex; gap: 16px; flex-wrap: wrap; margin-top: 12px; }
  .meta-row b { color: var(--text-mid); font-weight: 500; }
  .card { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 24px; transition: border-color 0.2s ease, transform 0.2s ease; position: relative; overflow: hidden; }
  .card:hover { border-color: var(--line-strong); }
  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tag { font-size: 11px; font-family: var(--font-mono); font-weight: 500; color: var(--text-mid); background: rgba(255, 255, 255, 0.04); border: 1px solid var(--line); padding: 2px 8px; border-radius: 4px; letter-spacing: 0.02em; }
  .fade-up { animation: fade-in-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes fade-in-up { 0% { opacity: 0; transform: translateY(12px); } 100% { opacity: 1; transform: translateY(0); } }
  .site-footer { margin-top: 96px; padding: 28px 0; border-top: 1px solid var(--line); }
  .site-footer-inner { display: flex; justify-content: space-between; align-items: center; }
  .copyright { color: var(--text-dim); font-family: var(--font-mono); font-size: 12px; margin: 0; letter-spacing: 0.02em; }
  @media (max-width: 768px) {
    .site-header { flex-direction: column; align-items: flex-start; gap: 14px; }
    .primary-nav { margin-left: -8px; }
    .section { margin-top: 64px; }
  }
</style>
